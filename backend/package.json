{
  "name": "starter",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon app.js",
    "start:prod": "cross-env NODE_ENV=production node app.js",
    "seed": "node seeders/index.js",
    "seed:main": "node seeders/mainSeeder.js",
    "seed:additional": "node seeders/additionalSeeder.js",
    "seed:supplier-settings": "node seeders/supplierSettingsSeeder.js",
    "seed:reset": "node seeders/resetDatabase.js",
    "build:exe": "pkg app.js --targets node18-win-x64 --output ../release/OneM-Backend.exe"
  },
  "bin": "app.js",
  "pkg": {
    "assets": [
      "Config/**/*",
      "controllers/**/*",
      "data/**/*",
      "middlewares/**/*",
      "Model/**/*",
      "routes/**/*",
      "services/**/*",
      "utils/**/*",
      "database/**/*",
      "node_modules/mysql2/**/*",
      "node_modules/bcrypt/**/*",
      ".env"
    ],
    "scripts": [
      "node_modules/mysql2/**/*.js",
      "node_modules/bcrypt/**/*.js"
    ],
    "outputPath": "../release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "googleapis": "^153.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1",
    "pug": "^3.0.3",
    "qs": "^6.14.0",
    "sequelize": "^6.37.7",
    "slugify": "^1.6.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0"
  }
}
